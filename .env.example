# The public, canonical production URL. Required to enable canonical links.
VITE_SITE_URL=https://your-domain.example

# Optional. Add the token provided by Google Search Console after ownership is verified.
VITE_GOOGLE_SEARCH_CONSOLE_VERIFICATION=

# Optional HTTPS endpoint that accepts a JSON contact form submission.
# When absent, the form opens the visitor's email client as a graceful fallback.
VITE_CONTACT_FORM_ENDPOINT=
