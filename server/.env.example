# Legacy Node API only. The consolidated production API is ProjectsApi (C#).
# Required MongoDB Atlas connection string. Keep this file free of real credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Set this to production in the deployed API environment.
NODE_ENV=production

# Port used by the contact API.
PORT=3001

# Comma-separated frontend URLs allowed to submit the contact form. Replace the
# development example with the exact HTTPS production frontend URL when deploying.
ALLOWED_ORIGINS=http://localhost:5173

# Set to true only when the API runs behind one trusted reverse proxy.
TRUST_PROXY=false

# Optional DNS resolvers for Windows/hosting environments with Atlas SRV lookup issues.
DNS_SERVERS=
